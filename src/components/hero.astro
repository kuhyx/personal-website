---
/** Intro block: name, title, one-line summary, and contact links. */
import { cv } from "../data/cv";

const { header, summary } = cv;
---

<header class="hero">
  <h1>{header.name}</h1>
  <p class="hero__title">{header.titleEn}</p>
  <p class="hero__summary">{summary.en}</p>
  <nav class="hero__links" aria-label="Contact">
    <a href={`mailto:${header.email}`}>{header.email}</a>
    <a href={header.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={header.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    <a href={`https://discord.com/users/${header.discord}`} target="_blank" rel="noreferrer">Discord</a>
  </nav>
</header>
