---
/** One post: title, date and tags, the rendered body, and a way back. */
import type { PostMeta } from "../lib/frontmatter";
import Icon from "./icon.astro";
import PostBody from "./post-body.astro";
import PostMetaLine from "./post-meta.astro";

interface Props {
  readonly meta: PostMeta;
}

const { meta } = Astro.props;
---

<article class="post">
  <h1>{meta.title}</h1>
  <PostMetaLine meta={meta} />
  <PostBody><slot /></PostBody>
  <p class="post__back"><a href="/blog" aria-label="All posts"><Icon name="back" /></a></p>
</article>
