---
/** The post list, newest first. textgate: heading and empty state are glyphs. */
import type { Post } from "../lib/posts";
import Icon from "./icon.astro";
import PostMetaLine from "./post-meta.astro";

interface Props {
  readonly posts: readonly Post[];
}

const { posts } = Astro.props;
---

<section class="blog" aria-labelledby="blog-heading">
  <h1 id="blog-heading" aria-label="Blog"><Icon name="blog" /></h1>
  {
    posts.length === 0 ? (
      <p class="blog__empty"><Icon name="empty" /><span class="sr-only">Nothing published yet.</span></p>
    ) : (
      <ul class="blog__list">
        {posts.map((post) => (
          <li class="blog__entry">
            <h2>
              <a href={`/blog/${post.slug}`}>{post.meta.title}</a>
            </h2>
            <PostMetaLine meta={post.meta} />
            <p class="blog__summary">{post.meta.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>
