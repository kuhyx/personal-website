---
/**
 * `/logo-lab`: every logo candidate side by side, so kuhy can pick one.
 * textgate: the ids A to F are the only painted text. Per candidate, on a
 * light and a dark swatch (the site's two page backgrounds): the header mark
 * at nav size, the favicon at true 16 and 32 px, and the og:image card. The
 * candidate's large mark is the button that tries it on the live header
 * (public/logo-switch.js); the reset glyph goes back to the current look.
 */
import Icon from "./icon.astro";
import { CANDIDATES, OG_SIZE, assetPath } from "../lib/logo-lab";

const SCHEMES = ["light", "dark"] as const;
---

<section class="logo-lab">
  <h1 class="sr-only">Logo candidates</h1>
  <button type="button" class="logo-lab__reset" data-logo-reset aria-label="Back to no header mark">
    <Icon name="back" />
  </button>
  {
    CANDIDATES.map((candidate) => (
      <article class="logo-lab__candidate" aria-labelledby={`logo-${candidate.id}`}>
        <h2 id={`logo-${candidate.id}`}>{candidate.label}</h2>
        <span class="sr-only">{candidate.name}</span>
        <button
          type="button"
          class="logo-lab__pick"
          data-logo={candidate.id}
          aria-label={`Try ${candidate.name} as the header mark`}
        >
          <img src={assetPath(candidate.id, "logo.svg")} width="96" height="96" alt="" />
        </button>
        {SCHEMES.map((scheme) => (
          <div class={`logo-lab__swatch logo-lab__swatch--${scheme}`} data-swatch={`${candidate.id}-${scheme}`}>
            <img src={assetPath(candidate.id, "logo.svg")} width="28" height="28" alt="" />
            <img src={assetPath(candidate.id, "16.png")} width="16" height="16" alt="" />
            <img src={assetPath(candidate.id, "32.png")} width="32" height="32" alt="" />
            <img
              class="logo-lab__og"
              src={assetPath(candidate.id, "og.png")}
              width={OG_SIZE.width}
              height={OG_SIZE.height}
              alt=""
              loading="lazy"
            />
          </div>
        ))}
      </article>
    ))
  }
</section>

<style>
  .logo-lab {
    display: grid;
    gap: var(--space-5);
  }

  .logo-lab__reset,
  .logo-lab__pick {
    justify-self: start;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--fg);
    cursor: pointer;
  }

  .logo-lab__pick img {
    display: block;
    border-radius: var(--radius-sm);
  }

  .logo-lab__candidate {
    display: grid;
    gap: var(--space-3);
  }

  .logo-lab__candidate h2 {
    margin: 0;
  }

  .logo-lab__swatch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  /* The site's own page backgrounds (unified-design-system paper and ink). */
  .logo-lab__swatch--light {
    background: #f6f4f3;
  }

  .logo-lab__swatch--dark {
    background: #211d1b;
  }

  .logo-lab__og {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
</style>
