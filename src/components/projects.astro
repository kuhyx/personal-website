---
/**
 * The projects showcase. Ships as a spinner; the script below replaces it
 * with one live fetch of the public GitHub repos. textgate: the heading and
 * every state are glyphs with spoken-only labels.
 */
import Icon from "./icon.astro";
---

<section class="projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading" aria-label="Projects"><Icon name="projects" /></h2>
  <div class="projects__body" data-projects aria-busy="true">
    <span class="spinner" role="progressbar" aria-label="Loading projects"></span>
  </div>
</section>

<script>
  import { mountProjects } from "../lib/projects";

  const container = document.querySelector<HTMLElement>("[data-projects]");
  if (container !== null) {
    void mountProjects(container);
  }
</script>
