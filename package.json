{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Personal website for kuhy.duckdns.org — projects showcase + CV.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/lint-blog.mjs && astro check && astro build",
    "build:admin": "vite build --ssr scripts/admin.mjs --outDir dist-admin && vite build --config vite.admin.config.ts",
    "admin": "node dist-admin/admin.js",
    "lint:blog": "node scripts/lint-blog.mjs",
    "lint": "node scripts/lint-blog.mjs && astro sync && tsc --noEmit && eslint src && astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@kuhyx/web-ui": "github:kuhyx/utils#web_ui-v0.5.0&path:/web_ui",
    "astro": "7.4.7",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
